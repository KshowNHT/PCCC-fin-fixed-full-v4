# Copy this file to ".env" in the project root.
# The defaults in compose.yaml are enough for a first LOCAL test,
# but change passwords/secrets before using the application beyond local development.

GEMINI_API_KEY=""

POSTGRES_PASSWORD="pccc_dev_pass"

# Use a long random value in real use (openssl rand -hex 32). Minimum 32 chars.
# The backend REFUSES TO START in production if this is left at the default
# below, or if it's shorter than 32 characters.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_pccc_secret_key"

# Minimum 10 characters, must contain both letters and numbers. The backend
# REFUSES TO START in production if this is left at "admin123".
PCCC_ADMIN_USERNAME="admin"
PCCC_ADMIN_PASSWORD="admin123"

MAX_STAFF_ACCOUNTS=10

# Comma-separated list of frontend origins allowed to call the API directly
# (cross-origin). Most normal traffic goes through the frontend's own Nginx
# proxy (same-origin, not affected by this setting) — this mainly matters
# for direct API access from a different domain. When deploying with a real
# domain, add it here, e.g.: "https://pccc.yourcompany.com"
PCCC_ALLOWED_ORIGINS="http://localhost:5173"

# Max upload size (MB) and JWT expiry (minutes).
MAX_UPLOAD_SIZE_MB=25
JWT_EXPIRE_MINUTES=480

# FIX QUAN TRỌNG (rà soát "sẵn sàng chạy online" lần 4): trước đây giá trị
# mặc định là "http://localhost:8000" — bị "đóng cứng" vào file JS lúc build,
# khiến ứng dụng KHÔNG chạy được khi truy cập từ domain/IP khác localhost
# (đã kiểm chứng bằng cách build thử và tấn công giả lập domain thật).
# Để TRỐNG (giá trị rỗng) = dùng đường dẫn API tương đối, tự động đúng trên
# MỌI domain/IP nhờ Nginx proxy — đây là giá trị đúng cho hầu hết trường hợp,
# KHÔNG cần đổi. Chỉ điền giá trị cụ thể nếu bạn triển khai frontend và
# backend trên 2 domain hoàn toàn tách biệt (không qua chung 1 Nginx).
VITE_API_BASE_URL=""

# Bổ sung: "khoá chặn" tài khoản test (role "staff") mở DevTools trình
# duyệt để xem/khai thác mã nguồn phía client. Tài khoản "admin" luôn được
# miễn trừ. Đây là biện pháp RĂN ĐE ở tầng trình duyệt, KHÔNG PHẢI bảo mật
# tuyệt đối — xem cảnh báo kỹ thuật đầy đủ trong
# frontend/src/lib/codeProtection.ts trước khi bật. Mặc định "false".
# Đặt "true" khi build bản demo/nghiệm thu chia sẻ username/password ra
# bên ngoài (khách hàng, đối tác test độc lập...).
VITE_ENABLE_CODE_PROTECTION="false"
