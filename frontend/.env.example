# URL của backend Python (FastAPI). Để trống nếu frontend và backend được
# phục vụ chung một origin (backend mount sẵn dist/ ở production).
VITE_API_BASE_URL="http://localhost:3000"

# Bật/tắt "khoá chặn" tài khoản test (role "staff") mở DevTools trình duyệt
# để xem/khai thác mã nguồn phía client (xem cảnh báo kỹ thuật đầy đủ trong
# frontend/src/lib/codeProtection.ts — đây KHÔNG PHẢI bảo mật tuyệt đối, chỉ
# là biện pháp răn đe ở tầng trình duyệt). Tài khoản "admin" luôn được miễn
# trừ. Mặc định TẮT — chỉ bật ("true") khi build riêng cho môi trường demo/
# nghiệm thu công khai chia sẻ username/password cho bên ngoài.
VITE_ENABLE_CODE_PROTECTION="false"
