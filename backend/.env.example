# --- AI ---
GEMINI_API_KEY=""

# --- Server ---
PORT=3000
NODE_ENV="production"

# --- Database (PostgreSQL) — Ngày 1 kế hoạch ---
# Định dạng: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://pccc_app:CHANGE_ME@postgres:5432/pccc_db"

# --- Auth / JWT — Ngày 1 kế hoạch ---
# BẮT BUỘC đổi giá trị này trước khi triển khai production thật (tối thiểu 32
# ký tự). Tạo bằng: openssl rand -hex 32
# LƯU Ý: nếu NODE_ENV=production, backend sẽ TỪ CHỐI KHỞI ĐỘNG khi giá trị
# này vẫn còn là mặc định hoặc quá ngắn (xem app/config.py::assert_production_secrets_are_safe).
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_LONG_SECRET_MIN_32_CHARS"
JWT_EXPIRE_MINUTES=480

# Giới hạn tối đa số tài khoản nhân viên theo hợp đồng (Ngày 1-2 kế hoạch)
MAX_STAFF_ACCOUNTS=10

# Tài khoản admin khởi tạo tự động lần đầu.
# BẮT BUỘC: mật khẩu tối thiểu 10 ký tự, có cả chữ và số. Đổi ngay sau khi
# đăng nhập lần đầu qua PUT /api/auth/me/password (backend cũng sẽ từ chối
# khởi động ở production nếu để mặc định "admin123").
PCCC_ADMIN_USERNAME="admin"
PCCC_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD_123"

# Danh sách domain CORS được phép, phân tách bởi dấu phẩy (Security fix: bản
# trước hardcode 1 domain demo không liên quan, đã bỏ).
PCCC_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Giới hạn dung lượng file upload (MB) và độ dài tin nhắn chat (ký tự) —
# chống DoS/lạm dụng chi phí gọi Gemini API.
MAX_UPLOAD_SIZE_MB=25
MAX_CHAT_MESSAGE_LENGTH=8000

# --- Thư mục dữ liệu / frontend build tĩnh ---
PCCC_DATA_DIR=""
PCCC_FRONTEND_DIST=""
