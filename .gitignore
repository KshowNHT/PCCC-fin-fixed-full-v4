# =========================================================
# PCCC Project - Root .gitignore
# Python / FastAPI + React / Vite + Docker
# =========================================================

# -------------------------
# Secrets / environment
# -------------------------
.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
frontend/node_modules/

frontend/dist/
frontend/build/
.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Docker / local runtime
# -------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Local runtime/generated application data
backend/data/uploads/
backend/data/drawings/

# Generated fonts downloaded at runtime
backend/data/Roboto-Regular.ttf
backend/data/Roboto-Medium.ttf

# -------------------------
# Logs / temporary files
# -------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# -------------------------
# Databases / local dumps
# -------------------------
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# -------------------------
# IDE / editor
# -------------------------
.vscode/
.idea/
*.code-workspace

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# TypeScript
# -------------------------
*.tsbuildinfo

# -------------------------
# Misc
# -------------------------
.cache/
.parcel-cache/
