# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG FRONTEND MẪU (Copy thành file frontend/.env khi sử dụng)
# ==============================================================================

# 1. Đường dẫn API Backend (FastAPI):
# - Khi chạy dưới máy Local (Dev): "http://localhost:3000"
# - Khi deploy Production tách rời Backend: "https://api.tenmien.com"
# - Khi deploy Production chung Nginx/Caddy reverse proxy: ""
VITE_API_BASE_URL="http://localhost:3000"

# 2. Bật/tắt "khoá chặn" tài khoản nhân viên (role "staff") mở DevTools trình duyệt:
# - Tài khoản "admin" luôn được miễn trừ.
# - Mặc định "false" khi dev; đặt "true" khi build bản demo/nghiệm thu công khai.
VITE_ENABLE_CODE_PROTECTION="false"
